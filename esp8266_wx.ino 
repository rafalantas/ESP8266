String aprsZuluTimestamp() {
  time_t now = time(nullptr);
  struct tm tmUtc;
  gmtime_r(&now, &tmUtc);
  char buf[8];
  snprintf(buf, sizeof(buf), "%02d%02d%02dz", tmUtc.tm_mday, tmUtc.tm_hour, tmUtc.tm_min);
  return String(buf);
}

