bool sendWindy(float tempC, float hum, float pressHpa) {
  std::unique_ptr<BearSSL::WiFiClientSecure> client(new BearSSL::WiFiClientSecure);
  client->setInsecure();

  if (!client->connect(WINDY_HOST, 443)) {
    DBG_PRINTLN("[Windy] connect failed");
    return false;
  }

  String url = "/pws/update/" + String(WINDY_API_KEY) +
               "?station=" + String(WINDY_STATION) +
               "&temp=" + String(tempC, 1) +
               "&humidity=" + String((int)round(hum)) +
               "&mbar=" + String(pressHpa, 1);

  client->print(String("GET ") + url + " HTTP/1.1\r\nHost: " + WINDY_HOST + "\r\nConnection: close\r\n\r\n");
  client->stop();
  return true;
}

