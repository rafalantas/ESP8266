}

bool updateTimeStatus() {
  time_t now = time(nullptr);
  timeSynced = (now > 1600000000);
  return timeSynced;
}

String aprsZuluTimestamp() {
  time_t now = time(nullptr);
  struct tm tmUtc;
  gmtime_r(&now, &tmUtc);

  char buf[8];
  snprintf(buf, sizeof(buf), "%02d%02d%02dz",
           tmUtc.tm_mday, tmUtc.tm_hour, tmUtc.tm_min);
  return String(buf);
}

String isoUtcNow() {
  if (!timeSynced) return String("unsynced");
  time_t now = time(nullptr);
  struct tm tmUtc;
  gmtime_r(&now, &tmUtc);

  char buf[24];
  snprintf(buf, sizeof(buf), "%04d-%02d-%02d %02d:%02d:%02d UTC",
           tmUtc.tm_year + 1900, tmUtc.tm_mon + 1, tmUtc.tm_mday,
           tmUtc.tm_hour, tmUtc.tm_min, tmUtc.tm_sec);
  return String(buf);
}

