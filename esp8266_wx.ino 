bool sendThingSpeakPrimary(float tempC, float hum, float pressHpa, float vpm25, float vpm10) {
  lastThingSpeakAttempt = millis();
  thingSpeakLastOk = false;
  thingSpeakLastHttpCode = 0;
  thingSpeakLastError = "pending";

  WiFiClient client;
  if (!client.connect(THINGSPEAK_HOST, 80)) {
    thingSpeakFailCount++;
    thingSpeakLastError = "connect failed";
    return false;
  }

  String url = "/update?api_key=" + String(THINGSPEAK_API_KEY_1) +
               "&field1=" + String(tempC,1) +
               "&field2=" + String(hum,1) +
               "&field3=" + String(pressHpa,1) +
               "&field4=" + String(vpm25,1) +
               "&field5=" + String(vpm10,1);

  client.print(String("GET ") + url + " HTTP/1.1\r\nHost: " + THINGSPEAK_HOST + "\r\nConnection: close\r\n\r\n");

  unsigned long timeout = millis();
  String firstLine = "";
  String body = "";
  bool gotHeaders = false;
  bool inBody = false;

  while ((client.connected() || client.available()) && millis() - timeout < 8000) {
    while (client.available()) {
      String line = client.readStringUntil('\n');
      timeout = millis();

      if (!gotHeaders) {
        String trimmed = line;
        trimmed.trim();

        if (trimmed.length() > 0 && firstLine.length() == 0) {
          firstLine = trimmed;
          if (trimmed.startsWith("HTTP/1.1 ") || trimmed.startsWith("HTTP/1.0 ")) {
            thingSpeakLastHttpCode = trimmed.substring(9, 12).toInt();
          }
        }

        if (line == "\r" || trimmed.length() == 0) {
          gotHeaders = true;
          inBody = true;
        }
      } else if (inBody) {
        body += line;
      }
    }
  }

  client.stop();
  body.trim();

  if (thingSpeakLastHttpCode == 200 && body.length() > 0 && body != "0") {
    thingSpeakLastOk = true;
    thingSpeakLastError = "entry " + body;
    lastThingSpeakSuccess = millis();
    return true;
  }

  thingSpeakFailCount++;
  if (thingSpeakLastHttpCode == 200 && body == "0") {
    thingSpeakLastError = "entry 0";
  } else if (body.length() > 0) {
    thingSpeakLastError = body;
  } else if (firstLine.length() > 0) {
    thingSpeakLastError = firstLine;
  } else {
    thingSpeakLastError = "timeout/no response";
  }

  return false;
}

bool sendWindyV2(float tempC, float hum, float pressHpa) {
  lastWindyAttempt = millis();
  windyLastOk = false;
  windyLastHttpCode = 0;
  windyLastError = "unknown";

  std::unique_ptr<BearSSL::WiFiClientSecure> client(new BearSSL::WiFiClientSecure);
  client->setInsecure();

  if (!client->connect(WINDY_HOST, 443)) {
    windyLastError = "connect failed";
    windyFailCount++;
    return false;
  }

  float tempF = tempC * 9.0f / 5.0f + 32.0f;
  float baroInHg = pressHpa * 0.0295299831f;

  String url = "/api/v2/observation/update"
               "?stationtype=ESP8266WX_2.8"
               "&ID=" + String(WINDY_STATION_ID) +
               "&PASSWORD=" + String(WINDY_STATION_PASSWORD) +
               "&dateutc=now"
               "&tempf=" + String(tempF, 1) +
               "&humidity=" + String((int)round(hum)) +
               "&baromin=" + String(baroInHg, 3) +
               "&action=updateraw";

  DBG_PRINT("[Windy] URL: ");
  DBG_PRINTLN(url);

  client->print(String("GET ") + url + " HTTP/1.1\r\n" +
                "Host: " + WINDY_HOST + "\r\n" +
                "Connection: close\r\n\r\n");

  unsigned long timeout = millis();
  String firstLine = "";
  bool gotHeaders = false;

  while (client->connected() && millis() - timeout < 5000) {
    while (client->available()) {
      String line = client->readStringUntil('\n');
      line.trim();
      timeout = millis();

      if (!gotHeaders && line.length() > 0) {
        firstLine = line;
        gotHeaders = true;
        if (line.startsWith("HTTP/1.1 ") || line.startsWith("HTTP/1.0 ")) {
          windyLastHttpCode = line.substring(9, 12).toInt();
        }
      }
    }
  }

  client->stop();

  if (windyLastHttpCode == 200) {
    windyLastOk = true;
    windyLastError = "ok";
    lastWindySuccess = millis();
    return true;
  }

  windyFailCount++;
  windyLastError = firstLine.length() ? firstLine : "timeout/no response";
  return false;
}

