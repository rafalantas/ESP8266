String uptimeString() {
  unsigned long s = millis() / 1000UL, d = s / 86400UL; s %= 86400UL;
  unsigned long h = s / 3600UL; s %= 3600UL; unsigned long m = s / 60UL; s %= 60UL;
  char buf[32];
  snprintf(buf, sizeof(buf), "%lud %02luh %02lum %02lus", d, h, m, s);
  return String(buf);
}

String ageSecondsToText(unsigned long msAgo) {
  unsigned long s = msAgo / 1000UL, d = s / 86400UL; s %= 86400UL;
  unsigned long h = s / 3600UL; s %= 3600UL; unsigned long m = s / 60UL; s %= 60UL;
  char buf[40];
  if (d > 0) snprintf(buf, sizeof(buf), "%lud %02luh %02lum %02lus", d, h, m, s);
  else snprintf(buf, sizeof(buf), "%02luh %02lum %02lus", h, m, s);
  return String(buf);
}

String jsonEscape(const String &input) {
  String out;
  out.reserve(input.length() + 8);
  for (size_t i = 0; i < input.length(); i++) {
    char c = input[i];
    if (c == '\\' || c == '"') { out += '\\'; out += c; }
    else if (c == '\n') out += "\\n";
    else if (c == '\r') out += "\\r";
    else if (c == '\t') out += "\\t";
    else out += c;
  }
  return out;
}

bool validPressure(float p) { return !isnan(p) && p >= 850.0f && p <= 1100.0f; }
bool validTemp(float t) { return !isnan(t) && t > -40.0f && t < 85.0f; }
bool validHumidity(float h) { return !isnan(h) && h >= 0.0f && h <= 100.0f; }

void updateBmeCache() {
  if (!bmeOk) {
    lastTempC = NAN;
    lastHum = NAN;
    lastPressHpa = NAN;
    return;
  }

  float t = bme.readTemperature();
  float h = bme.readHumidity();
  float p = bme.readPressure() / 100.0f;

  if (validTemp(t)) lastTempC = t;
  if (validHumidity(h)) lastHum = h;
  if (validPressure(p)) lastPressHpa = p;
}

void updateSensorsIfNeeded() {
  if (lastSensorCache == 0 || millis() - lastSensorCache >= SENSOR_CACHE_MS) {
    lastSensorCache = millis();
    updateBmeCache();
  }
}

