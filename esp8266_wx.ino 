String padAddressee9(const String &call) {
  String s = call;
  while (s.length() < 9) s += " ";
  if (s.length() > 9) s = s.substring(0, 9);
  return s;
}

String telemetryMessagePacket(const char* fromCall, const char* toCall, const String &payload) {
  return String(fromCall) + ">" + APRS_DEST + ",TCPIP*::" + padAddressee9(String(toCall)) + ":" + payload;
}

