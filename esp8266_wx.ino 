void sdsSendCommand(const uint8_t *cmd, size_t len) {
  while (sdsSerial.available()) sdsSerial.read();
  for (size_t i = 0; i < len; i++) sdsSerial.write(cmd[i]);
  sdsSerial.flush();
}

void sdsSleep() {
  static const uint8_t cmd[] = {
    0xAA, 0xB4, 0x06, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0xFF, 0xFF, 0x05, 0xAB
  };
  sdsSendCommand(cmd, sizeof(cmd));
}

void sdsWake() {
  static const uint8_t cmd[] = {
    0xAA, 0xB4, 0x06, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0xFF, 0xFF, 0x06, 0xAB
  };
  sdsSendCommand(cmd, sizeof(cmd));
}

bool readSDS011(float &outPm25, float &outPm10) {
  while (sdsSerial.available() >= 10) {
    if ((uint8_t)sdsSerial.read() != 0xAA) continue;
    if ((uint8_t)sdsSerial.read() != 0xC0) continue;

    uint8_t data[8];
    int got = sdsSerial.readBytes((char*)data, 8);
    if (got != 8) return false;

    uint8_t checksum = 0;
    for (int i = 0; i < 6; i++) checksum += data[i];
    if (checksum != data[6]) return false;
    if (data[7] != 0xAB) return false;

    uint16_t rawPm25 = (uint16_t)data[0] | ((uint16_t)data[1] << 8);
    uint16_t rawPm10 = (uint16_t)data[2] | ((uint16_t)data[3] << 8);

    outPm25 = rawPm25 / 10.0f;
    outPm10 = rawPm10 / 10.0f;
    return true;
  }
  return false;
}

void startMdnsIfNeeded() {
  if (WiFi.status() == WL_CONNECTED && !mdnsStarted) {
    if (MDNS.begin(MDNS_NAME)) {
      MDNS.addService("http", "tcp", 80);
      mdnsStarted = true;
    }
  }
}

void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  Serial.println();
  Serial.print("[WIFI] Connecting to: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.hostname(DEVICE_HOSTNAME);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();

  wl_status_t st = WiFi.status();
  Serial.print("[WIFI] status=");
  Serial.println((int)st);

  if (st == WL_CONNECTED) {
    Serial.print("[WIFI] Connected, IP: ");
    Serial.println(WiFi.localIP());
    Serial.print("[WIFI] Hostname: ");
    Serial.println(WiFi.hostname());
    initTime();
    startMdnsIfNeeded();
  } else {
    Serial.println("[WIFI] FAILED");
  }
}

bool connectAprs() {
  if (aprsClient.connected()) return true;

  if (!aprsClient.connect(APRS_HOST, APRS_PORT)) {
    aprsLoggedIn = false;
    return false;
  }

  String login = aprsLoginLine();
  aprsClient.print(login);
  aprsClient.print("\r\n");
  aprsLoggedIn = true;
  return true;
}

void sendAprsLine(const String &line) {
  if (aprsClient.connected()) {
    aprsClient.print(line);
    aprsClient.print("\r\n");
  }
}

bool sendThingSpeak265521(float tempC, float hum, float pressHpa, float vpm25, float vpm10) {
  WiFiClient client;
  if (!client.connect(THINGSPEAK_HOST, 80)) {
    return false;
  }

  String url = "/update?api_key=" + String(THINGSPEAK_API_KEY_1) +
               "&field1=" + String(vpm25, 1) +
               "&field2=" + String(vpm10, 1) +
               "&field3=" + String(tempC, 1) +
               "&field4=" + String(hum, 1) +
               "&field5=" + String(pressHpa, 1);

  client.print(String("GET ") + url + " HTTP/1.1\r\nHost: " + THINGSPEAK_HOST + "\r\nConnection: close\r\n\r\n");
  client.stop();
  return true;
}

bool sendWindyV2(float tempC, float hum, float pressHpa) {
  std::unique_ptr<BearSSL::WiFiClientSecure> client(new BearSSL::WiFiClientSecure);
  client->setInsecure();

  windyLastAttemptTs = time(nullptr);
  windyLastHttpCode = 0;
  windyLastStatusLine = "request-init";
  windyLastBody = "";

  long pressurePa = lround(pressHpa * 100.0f);
  long ts = time(nullptr);

  String url = String("https://") + WINDY_HOST +
               "/api/v2/observation/update"
               "?id=" + String(WINDY_STATION_ID) +
               "&PASSWORD=" + String(WINDY_STATION_PASSWORD) +
               "&ts=" + String(ts) +
               "&temp=" + String(tempC, 1) +
               "&humidity=" + String((int)round(hum)) +
               "&pressure=" + String(pressurePa) +
               "&softwaretype=ESP8266WX_2.6";

  HTTPClient https;
  https.setTimeout(8000);
  https.setReuse(false);

  if (!https.begin(*client, url)) {
    windyLastOk = false;
    windyFailCount++;
    windyLastStatusLine = "http-begin-failed";
    return false;
  }

  int httpCode = https.GET();
  windyLastHttpCode = httpCode;

  if (httpCode > 0) {
    windyLastStatusLine = String("HTTP ") + String(httpCode);
    windyLastBody = https.getString();
  } else {
    windyLastStatusLine = String("HTTPClient error: ") + https.errorToString(httpCode);
  }

  https.end();

  bool ok = (httpCode == 200 || httpCode == 409);
  windyLastOk = ok;

  if (ok) {
    windyLastSuccessTs = windyLastAttemptTs;
    windySuccessCount++;
  } else {
    windyFailCount++;
  }

  return ok;
}

