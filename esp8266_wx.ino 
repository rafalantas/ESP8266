String boolText(bool v) {
  return v ? "true" : "false";
}

String fmtFloatOrNull(float v, int prec = 1) {
  if (isnan(v)) return "null";
  return String(v, prec);
}

String fmtIp() {
  if (WiFi.status() == WL_CONNECTED) return WiFi.localIP().toString();
  return String("0.0.0.0");
}

String uptimeString() {
  unsigned long s = millis() / 1000UL;
  unsigned long d = s / 86400UL;
  s %= 86400UL;
  unsigned long h = s / 3600UL;
  s %= 3600UL;
  unsigned long m = s / 60UL;
  s %= 60UL;

  char buf[32];
  snprintf(buf, sizeof(buf), "%lud %02luh %02lum %02lus", d, h, m, s);
  return String(buf);
}

bool validPressure(float p) {
  return !isnan(p) && p >= 850.0f && p <= 1100.0f;
}

bool validTemp(float t) {
  return !isnan(t) && t > -40.0f && t < 85.0f;
}

bool validHumidity(float h) {
  return !isnan(h) && h >= 0.0f && h <= 100.0f;
}

void updateBmeCache() {
  if (!bmeOk) {
    lastTempC = NAN;
    lastHum = NAN;
    lastPressHpa = NAN;
    return;
  }

  float t = bme.readTemperature();
  float h = bme.readHumidity();
  float p = bme.readPressure() / 100.0f;

  if (validTemp(t)) lastTempC = t;
  if (validHumidity(h)) lastHum = h;
  if (validPressure(p)) lastPressHpa = p;
}

void updateSensorsIfNeeded() {
  if (lastSensorCache == 0 || millis() - lastSensorCache >= SENSOR_CACHE_MS) {
    lastSensorCache = millis();
    updateBmeCache();
  }
}

