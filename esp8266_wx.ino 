String boolText(bool v) { return v ? "true" : "false"; }

String fmtFloatOrNull(float v, int prec = 1) {
  if (isnan(v)) return "null";
  return String(v, prec);
}

String jsonEscape(const String &input) {
  String out;
  out.reserve(input.length() + 8);
  for (size_t i = 0; i < input.length(); i++) {
    char c = input[i];
    if (c == '\\' || c == '"') { out += '\\'; out += c; }
    else if (c == '\n') out += "\\n";
    else if (c == '\r') out += "\\r";
    else if (c == '\t') out += "\\t";
    else out += c;
  }
  return out;
}

bool validPressure(float p) { return !isnan(p) && p >= 850.0f && p <= 1100.0f; }
bool validTemp(float t) { return !isnan(t) && t > -40.0f && t < 85.0f; }
bool validHumidity(float h) { return !isnan(h) && h >= 0.0f && h <= 100.0f; }

void updateBmeCache() {
  if (!bmeOk) {
    lastTempC = NAN;
    lastHum = NAN;
    lastPressHpa = NAN;
    return;
  }

  float t = bme.readTemperature();
  float h = bme.readHumidity();
  float p = bme.readPressure() / 100.0f;

  if (validTemp(t)) lastTempC = t;
  if (validHumidity(h)) lastHum = h;
  if (validPressure(p)) lastPressHpa = p;
}

void updateSensorsIfNeeded() {
  if (lastSensorCache == 0 || millis() - lastSensorCache >= SENSOR_CACHE_MS) {
    lastSensorCache = millis();
    updateBmeCache();
  }
}

