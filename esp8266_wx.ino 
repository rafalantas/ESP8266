  json += "\"temperature\":" + fmtFloatOrNull(lastTempC, 1) + ",";
  json += "\"humidity\":" + fmtFloatOrNull(lastHum, 1) + ",";
  json += "\"pressure\":" + fmtFloatOrNull(lastPressHpa, 1) + ",";
  json += "\"pm25\":" + fmtFloatOrNull(pm25, 1) + ",";
  json += "\"pm10\":" + fmtFloatOrNull(pm10, 1) + ",";

  json += "\"sdsAwake\":" + boolText(sdsAwake) + ",";
  json += "\"sdsWaiting\":" + boolText(sdsWaitingForSample) + ",";
  json += "\"sdsFreshData\":" + boolText(sdsFreshData) + ",";

  json += "\"aprsConnected\":" + boolText(aprsClient.connected()) + ",";
  json += "\"aprsLoggedIn\":" + boolText(aprsLoggedIn) + ",";
  json += "\"aprsLastOk\":" + boolText(aprsLastOk) + ",";
  json += "\"aprsLastError\":\"" + jsonEscape(aprsLastError) + "\",";

  json += "\"thingSpeakLastOk\":" + boolText(thingSpeakLastOk) + ",";
  json += "\"thingSpeakLastHttpCode\":" + String(thingSpeakLastHttpCode) + ",";
  json += "\"thingSpeakLastError\":\"" + jsonEscape(thingSpeakLastError) + "\",";

  json += "\"windyEnabled\":" + boolText(ENABLE_WINDY) + ",";
  json += "\"windyLastOk\":" + boolText(windyLastOk) + ",";
  json += "\"windyLastHttpCode\":" + String(windyLastHttpCode) + ",";
  json += "\"windyLastError\":\"" + jsonEscape(windyLastError) + "\"";
  json += "}";
  return json;
}

