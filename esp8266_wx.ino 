void startMdnsIfNeeded() {
  if (WiFi.status() == WL_CONNECTED && !mdnsStarted) {
    if (MDNS.begin(MDNS_NAME)) {
      MDNS.addService("http", "tcp", 80);
      mdnsStarted = true;
      DBG_PRINT("[mDNS] Started: http://");
      DBG_PRINT(MDNS_NAME);
      DBG_PRINTLN(".local");
    } else {
      DBG_PRINTLN("[mDNS] Start failed");
    }
  }
}

void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  Serial.println();
  Serial.print("[WIFI] Connecting to: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.hostname(DEVICE_HOSTNAME);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();

  wl_status_t st = WiFi.status();
  Serial.print("[WIFI] status=");
  Serial.println((int)st);

  if (st == WL_CONNECTED) {
    Serial.print("[WIFI] Connected, IP: ");
    Serial.println(WiFi.localIP());
    Serial.print("[WIFI] Hostname: ");
    Serial.println(WiFi.hostname());
    initTime();
    startMdnsIfNeeded();
  } else {
    Serial.println("[WIFI] FAILED");
  }
}

bool connectAprs() {
  if (aprsClient.connected()) return true;

  DBG_PRINTF("[APRS] Connecting to %s:%u\n", APRS_HOST, APRS_PORT);
  if (!aprsClient.connect(APRS_HOST, APRS_PORT)) {
    DBG_PRINTLN("[APRS] TCP connect failed");
    aprsLoggedIn = false;
    return false;
  }

  String login = aprsLoginLine();
  aprsClient.print(login);
  aprsClient.print("\r\n");
  aprsLoggedIn = true;

  DBG_PRINT("[APRS] LOGIN >> ");
  DBG_PRINTLN(login);
  return true;
}

void sendAprsLine(const String &line) {
  DBG_PRINT("[APRS] TX >> ");
  DBG_PRINTLN(line);

  if (aprsClient.connected()) {
    aprsClient.print(line);
    aprsClient.print("\r\n");
  }
}

