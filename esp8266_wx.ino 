bool sendThingSpeakPrimary(float tempC, float hum, float pressHpa, float vpm25, float vpm10) {
  WiFiClient client;
  if (!client.connect(THINGSPEAK_HOST, 80)) {
    DBG_PRINTLN("[ThingSpeak1] connect failed");
    return false;
  }

  String url = "/update?api_key=" + String(THINGSPEAK_API_KEY_1) +
               "&field1=" + String(tempC, 1) +
               "&field2=" + String(hum, 1) +
               "&field3=" + String(pressHpa, 1) +
               "&field4=" + String(vpm25, 1) +
               "&field5=" + String(vpm10, 1);

  client.print(String("GET ") + url + " HTTP/1.1\r\nHost: " + THINGSPEAK_HOST + "\r\nConnection: close\r\n\r\n");
  client.stop();
  return true;
}

