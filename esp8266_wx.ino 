void handleStatus() {
  server.send(200, "application/json", getSystemJson());
}

void handleDebug() {
  if (server.hasArg("set")) {
    String v = server.arg("set");
    debugEnabled = (v == "1" || v == "true" || v == "on");
  }
  String json = "{";
  json += "\"debugEnabled\":";
  json += (debugEnabled ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void printSensorBlock() {
  DBG_PRINTLN("");
  DBG_PRINTLN("=== SENSOR DATA ===");
  DBG_PRINT("Temp C   : "); DBG_PRINTLN(lastTempC);
  DBG_PRINT("Hum %    : "); DBG_PRINTLN(lastHum);
  DBG_PRINT("Press hPa: "); DBG_PRINTLN(lastPressHpa);
  DBG_PRINT("PM2.5    : "); DBG_PRINTLN(pm25);
  DBG_PRINT("PM10     : "); DBG_PRINTLN(pm10);
  DBG_PRINT("SDS fresh: "); DBG_PRINTLN(sdsFreshData ? "YES" : "NO");
  DBG_PRINT("APRS OK  : "); DBG_PRINTLN(aprsLastOk ? "YES" : "NO");
  DBG_PRINT("TS OK    : "); DBG_PRINTLN(thingSpeakLastOk ? "YES" : "NO");
  DBG_PRINT("Windy OK : "); DBG_PRINTLN(windyLastOk ? "YES" : "NO");
}

void resetCycleSendFlags() {
  cycleAprsSent = false;
  cycleThingSpeakSent = false;
  cycleWindySent = false;
}

void setup() {
  Serial.begin(115200);
  delay(200);

  Serial.println();
  Serial.println("=== ESP8266 APRS WX START ===");
  Serial.print("[FW] ");
  Serial.println(FW_VERSION);

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  bmeOk = bme.begin(0x76);
  if (!bmeOk) bmeOk = bme.begin(0x77);

  sdsSerial.begin(9600);
  WiFi.mode(WIFI_STA);
  WiFi.hostname(DEVICE_HOSTNAME);

  windyClient.setInsecure();
  windyClient.setBufferSizes(512, 512);

  updateBmeCache();
  delay(1000);
  sdsSleep();
  connectWiFi();

  server.on("/", handleRoot);
  server.on("/status", handleStatus);
  server.on("/debug", handleDebug);
  server.begin();

  lastSdsCycle = millis();
  resetCycleSendFlags();
}

void loop() {
  server.handleClient();
  yield();

  if (millis() - lastWiFiCheck >= WIFI_CHECK_MS) {
    lastWiFiCheck = millis();
    if (WiFi.status() != WL_CONNECTED) {
      mdnsStarted = false;
      aprsLoggedIn = false;
      if (aprsClient.connected()) aprsClient.stop();
      if (windyClient.connected()) windyClient.stop();
      connectWiFi();
    }
  }

  updateTimeStatus();
  updateSensorsIfNeeded();
  startMdnsIfNeeded();

  if (WiFi.status() == WL_CONNECTED) connectAprs();

  if (!sdsAwake && !sdsWaitingForSample &&
      (lastSdsCycle == 0 || millis() - lastSdsCycle >= SDS_CYCLE_MS)) {
    lastSdsCycle = millis();
    resetCycleSendFlags();
    sdsFreshData = false;
    sdsWake();
    sdsAwake = true;
    sdsWaitingForSample = true;
    sdsWakeTime = millis();
  }

  if (sdsAwake && sdsWaitingForSample && millis() - sdsWakeTime >= SDS_WARMUP_MS) {
    float newPm25, newPm10;
    bool gotSample = false;
    unsigned long sampleStart = millis();

    while (millis() - sampleStart < SDS_SAMPLE_MS) {
      yield();
      if (readSDS011(newPm25, newPm10)) {
        pm25 = newPm25;
        pm10 = newPm10;
        sdsFreshData = true;
        cycleSampleTime = millis();
        gotSample = true;
        break;
      }
      delay(100);
    }

    sdsSleep();
    sdsAwake = false;
    sdsWaitingForSample = false;

    if (!gotSample) {
      DBG_PRINTLN("[SDS011] No valid sample after wake");
    }
  }

  if (millis() - lastSensorPrint >= SENSOR_PRINT_MS) {
    lastSensorPrint = millis();
    printSensorBlock();
  }

  if (WiFi.status() == WL_CONNECTED && aprsClient.connected()) {
    if (lastMeta == 0 || millis() - lastMeta >= META_MS) {
      lastMeta = millis();
      sendAprsLine(aprsParmLine());
      sendAprsLine(aprsUnitLine());
      sendAprsLine(aprsEqnsLine());
      sendAprsLine(aprsBitsLine());
    }

    if (lastRS == 0 || millis() - lastRS >= RS_MS) {
      lastRS = millis();
      sendAprsLine(aprsRadiosondeLine());
    }

    if (lastWeather == 0 || millis() - lastWeather >= WEATHER_MS) {
      lastWeather = millis();
      if (!isnan(lastTempC) && !isnan(lastHum) && !isnan(lastPressHpa) && timeSynced) {
        sendAprsLine(aprsWeatherLine(lastTempC, lastHum, lastPressHpa));
      }
    }
  }

  if (sdsFreshData && WiFi.status() == WL_CONNECTED) {
    if (!cycleAprsSent && aprsClient.connected()) {
      int pm25i = isnan(pm25) ? 0 : (int)round(pm25);
      int pm10i = isnan(pm10) ? 0 : (int)round(pm10);
      sendAprsLine(aprsTelemetryLine(telemSeq, pm25i, pm10i));
      telemSeq++;
      if (telemSeq > 999) telemSeq = 1;
      cycleAprsSent = true;
    }

    if (!cycleThingSpeakSent &&
        ENABLE_THINGSPEAK &&
        millis() - cycleSampleTime >= TS_DELAY_AFTER_SAMPLE_MS &&
        !isnan(lastTempC) && !isnan(lastHum) && !isnan(lastPressHpa) &&
        !isnan(pm25) && !isnan(pm10)) {
      thingSpeakLastOk = sendThingSpeakPrimary(lastTempC, lastHum, lastPressHpa, pm25, pm10);
      cycleThingSpeakSent = true;
    }

    if (!cycleWindySent &&
        ENABLE_WINDY &&
        millis() - cycleSampleTime >= WINDY_DELAY_AFTER_SAMPLE_MS &&
        timeSynced &&
        !isnan(lastTempC) && !isnan(lastHum) && !isnan(lastPressHpa)) {
      sendWindyV2(lastTempC, lastHum, lastPressHpa);
      cycleWindySent = true;
    }

    if (cycleAprsSent && cycleThingSpeakSent && cycleWindySent) {
      sdsFreshData = false;
    }
  }
}
