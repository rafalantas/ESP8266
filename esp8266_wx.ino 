  html += ".grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;}";
  html += ".card{background:#182028;border:1px solid #29333d;border-radius:14px;padding:14px;box-shadow:0 2px 8px rgba(0,0,0,.25);}";
  html += ".label{font-size:13px;color:#8fa2b5;text-transform:uppercase;letter-spacing:.06em;}";
  html += ".value{font-size:24px;font-weight:700;margin-top:6px;word-break:break-word;}";
  html += ".value.small{font-size:16px;line-height:1.4;}";
  html += ".ok{color:#7CFC8A;}.bad{color:#ff7f7f;}.mid{color:#ffd166;}";
  html += "pre{background:#0d1117;border:1px solid #29333d;border-radius:14px;padding:14px;overflow:auto;white-space:pre-wrap;word-break:break-word;}";
  html += "</style></head><body>";
  html += "<h1>ESP8266 Weather Station</h1>";
  html += "<p>Panel lokalny: czujniki, status wysylki APRS / ThingSpeak / Windy, debug przez WWW, hostname i mDNS.</p>";
  html += "<div class='top'><button onclick='toggleDebug()'>Przelacz debug</button><button onclick='loadStatus()'>Odswiez teraz</button></div>";
  html += "<div class='grid' id='cards'></div><h2>Stan JSON</h2><pre id='raw'>Ladowanie...</pre>";
  html += "<script>";
  html += "function val(v,u=''){return v===null?'--':String(v)+u;}";
  html += "function statusClass(v){return v?'ok':'bad';}";
  html += "function ageClass(txt){if(!txt||txt==='never')return 'bad';if(txt.includes('d'))return 'bad';let h=0,m=0;let mh=txt.match(/(\\d+)h/);let mm=txt.match(/(\\d+)m/);if(mh)h=parseInt(mh[1],10);if(mm)m=parseInt(mm[1],10);let total=h*60+m;if(total>=60)return 'bad';if(total>=15)return 'mid';return 'ok';}";
  html += "function card(title,value,cls,small){return `<div class='card'><div class='label'>${title}</div><div class='value ${(cls||'')} ${(small?'small':'')}'>${value}</div></div>`;}";
  html += "async function loadStatus(){let r=await fetch('/status');let d=await r.json();let c='';";
  html += "c+=card('FW',d.fwVersion);c+=card('Temperature',val(d.temperature,' C'));c+=card('Humidity',val(d.humidity,' %'));c+=card('Pressure',val(d.pressure,' hPa'));c+=card('PM2.5',val(d.pm25,' ug/m3'));c+=card('PM10',val(d.pm10,' ug/m3'));";
  html += "c+=card('APRS TCP',d.aprsConnected?'OK':'OFF',statusClass(d.aprsConnected));c+=card('APRS Login',d.aprsLoggedIn?'YES':'NO',d.aprsLoggedIn?'ok':'bad');c+=card('APRS status',d.aprsLastOk?'OK':'FAIL',d.aprsLastOk?'ok':'bad');c+=card('APRS last success',d.aprsSuccessAge,ageClass(d.aprsSuccessAge));c+=card('APRS fails',d.aprsFailCount,d.aprsFailCount>0?'bad':'ok');c+=card('APRS error',d.aprsLastError||'--',d.aprsLastOk?'ok':'bad',true);";
  html += "c+=card('ThingSpeak status',d.thingSpeakLastOk?'OK':'FAIL',d.thingSpeakLastOk?'ok':'bad');c+=card('ThingSpeak HTTP',d.thingSpeakLastHttpCode||0,d.thingSpeakLastOk?'ok':'mid');c+=card('ThingSpeak last success',d.thingSpeakSuccessAge,ageClass(d.thingSpeakSuccessAge));c+=card('ThingSpeak fails',d.thingSpeakFailCount,d.thingSpeakFailCount>0?'bad':'ok');c+=card('ThingSpeak error',d.thingSpeakLastError||'--',d.thingSpeakLastOk?'ok':'bad',true);";
  html += "c+=card('Windy enabled',d.windyEnabled?'YES':'NO',d.windyEnabled?'ok':'mid');c+=card('Windy status',d.windyLastOk?'OK':'FAIL',d.windyLastOk?'ok':'bad');c+=card('Windy HTTP',d.windyLastHttpCode||0,d.windyLastOk?'ok':'mid');c+=card('Windy last success',d.windySuccessAge,ageClass(d.windySuccessAge));c+=card('Windy fails',d.windyFailCount,d.windyFailCount>0?'bad':'ok');c+=card('Windy error',d.windyLastError||'--',d.windyLastOk?'ok':'bad',true);";
  html += "c+=card('WiFi',d.wifiConnected?'OK':'OFF',statusClass(d.wifiConnected));c+=card('NTP',d.timeSynced?'OK':'NO',statusClass(d.timeSynced));c+=card('Debug',d.debugEnabled?'ON':'OFF',d.debugEnabled?'mid':'');c+=card('BME280',d.bmeOk?'OK':'ERR',statusClass(d.bmeOk));c+=card('SDS Awake',d.sdsAwake?'YES':'NO',d.sdsAwake?'mid':'');c+=card('SDS Waiting',d.sdsWaitingForSample?'YES':'NO',d.sdsWaitingForSample?'mid':'');c+=card('SDS Fresh',d.sdsFreshData?'YES':'NO',d.sdsFreshData?'mid':'');c+=card('RSSI',d.rssi+' dBm');c+=card('Heap',d.heap+' B');c+=card('IP',d.ip);c+=card('Hostname',d.hostname);c+=card('mDNS',d.mdnsStarted?d.mdns:'not started',d.mdnsStarted?'ok':'bad');c+=card('Uptime',d.uptimeText);c+=card('UTC',d.utcNow);c+=card('Seq',d.telemSeq);";
  html += "document.getElementById('cards').innerHTML=c;document.getElementById('raw').textContent=JSON.stringify(d,null,2);}";
  html += "async function toggleDebug(){let r=await fetch('/status');let d=await r.json();let newValue=d.debugEnabled?0:1;await fetch('/debug?set='+newValue);await loadStatus();}";
  html += "setInterval(loadStatus,3000);loadStatus();";
  html += "</script></body></html>";
  return html;
}

void handleRoot() {
  server.send(200, "text/html; charset=utf-8", getHtmlPage());
}

void handleStatus() {
  updateSensorsIfNeeded();
  updateTimeStatus();
  server.send(200, "application/json", getSystemJson());
}

void handleDebug() {
  if (server.hasArg("set")) {
    String v = server.arg("set");
    debugEnabled = (v == "1" || v == "true" || v == "on");
  }
  String json = "{";
  json += "\"debugEnabled\":";
  json += (debugEnabled ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void printSensorBlock() {
  DBG_PRINTLN("");
  DBG_PRINTLN("=== SENSOR DATA ===");
  DBG_PRINT("Temp C   : "); DBG_PRINTLN(fmtFloatOrNull(lastTempC, 1));
  DBG_PRINT("Hum %    : "); DBG_PRINTLN(fmtFloatOrNull(lastHum, 1));
  DBG_PRINT("Press hPa: "); DBG_PRINTLN(fmtFloatOrNull(lastPressHpa, 1));
  DBG_PRINT("PM2.5    : "); DBG_PRINTLN(fmtFloatOrNull(pm25, 1));
  DBG_PRINT("PM10     : "); DBG_PRINTLN(fmtFloatOrNull(pm10, 1));
  DBG_PRINT("APRS OK  : "); DBG_PRINTLN(aprsLastOk ? "YES" : "NO");
  DBG_PRINT("TS OK    : "); DBG_PRINTLN(thingSpeakLastOk ? "YES" : "NO");
  DBG_PRINT("Windy OK : "); DBG_PRINTLN(windyLastOk ? "YES" : "NO");
  DBG_PRINT("TS err   : "); DBG_PRINTLN(thingSpeakLastError);
  DBG_PRINT("Windy err: "); DBG_PRINTLN(windyLastError);
}

void setup() {
  Serial.begin(115200);
  delay(200);

  Serial.println();
  Serial.println("=== ESP8266 APRS WX START ===");
  Serial.print("[FW] ");
  Serial.println(FW_VERSION);

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  bmeOk = bme.begin(0x76);
  if (!bmeOk) bmeOk = bme.begin(0x77);

  sdsSerial.begin(9600);
  WiFi.mode(WIFI_STA);
  WiFi.hostname(DEVICE_HOSTNAME);

  updateBmeCache();
  delay(1000);
  sdsSleep();
  connectWiFi();

  server.on("/", handleRoot);
  server.on("/status", handleStatus);
  server.on("/debug", handleDebug);
  server.begin();
}

void loop() {
  server.handleClient();

  if (millis() - lastWiFiCheck >= WIFI_CHECK_MS) {
    lastWiFiCheck = millis();
    if (WiFi.status() != WL_CONNECTED) {
      mdnsStarted = false;
      aprsLoggedIn = false;
      if (aprsClient.connected()) aprsClient.stop();
      connectWiFi();
    }
  }

  updateTimeStatus();
  updateSensorsIfNeeded();
  startMdnsIfNeeded();

  if (WiFi.status() == WL_CONNECTED) connectAprs();

  if (!sdsAwake && !sdsWaitingForSample &&
      (lastSdsCycle == 0 || millis() - lastSdsCycle >= SDS_CYCLE_MS)) {
    lastSdsCycle = millis();
    sdsWake();
    sdsAwake = true;
    sdsWaitingForSample = true;
    sdsWakeTime = millis();
  }

  if (sdsAwake && sdsWaitingForSample && millis() - sdsWakeTime >= SDS_WARMUP_MS) {
    float newPm25, newPm10;
    bool gotSample = false;
    unsigned long sampleStart = millis();

    while (millis() - sampleStart < SDS_SAMPLE_MS) {
      if (readSDS011(newPm25, newPm10)) {
        pm25 = newPm25;
        pm10 = newPm10;
        sdsFreshData = true;
        gotSample = true;
        break;
      }
      delay(100);
    }

    sdsSleep();
    sdsAwake = false;
    sdsWaitingForSample = false;

    if (!gotSample) DBG_PRINTLN("[SDS011] No valid sample after wake");
  }

  if (millis() - lastSensorPrint >= SENSOR_PRINT_MS) {
    lastSensorPrint = millis();
    printSensorBlock();
  }

  if (WiFi.status() == WL_CONNECTED && aprsClient.connected()) {
    if (lastMeta == 0 || millis() - lastMeta >= META_MS) {
      lastMeta = millis();
      sendAprsLine(aprsParmLine());
      sendAprsLine(aprsUnitLine());
      sendAprsLine(aprsEqnsLine());
      sendAprsLine(aprsBitsLine());
    }

    if (millis() - lastTelemetry >= TELEMETRY_MS && sdsFreshData) {
      lastTelemetry = millis();
      int pm25i = isnan(pm25) ? 0 : (int)round(pm25);
      int pm10i = isnan(pm10) ? 0 : (int)round(pm10);
      sendAprsLine(aprsTelemetryLine(telemSeq, pm25i, pm10i));
      telemSeq++;
      if (telemSeq > 999) telemSeq = 1;
      sdsFreshData = false;
    }

    if (lastWeather == 0 || millis() - lastWeather >= WEATHER_MS) {
      lastWeather = millis();
      if (!isnan(lastTempC) && !isnan(lastHum) && !isnan(lastPressHpa) && timeSynced) {
        sendAprsLine(aprsWeatherLine(lastTempC, lastHum, lastPressHpa));
      }
    }

    if (lastRS == 0 || millis() - lastRS >= RS_MS) {
      lastRS = millis();
      sendAprsLine(aprsRadiosondeLine());
    }
  }

  if (WiFi.status() == WL_CONNECTED &&
      ENABLE_THINGSPEAK &&
      !isnan(lastTempC) && !isnan(lastHum) && !isnan(lastPressHpa) &&
      !isnan(pm25) && !isnan(pm10)) {
    if (millis() - lastThingSpeak >= THINGSPEAK_MS) {
      thingSpeakLastOk = sendThingSpeakPrimary(lastTempC, lastHum, lastPressHpa, pm25, pm10);
      lastThingSpeak = millis();
    }
  }

  if (WiFi.status() == WL_CONNECTED &&
      ENABLE_WINDY &&
      timeSynced &&
      !isnan(lastTempC) && !isnan(lastHum) && !isnan(lastPressHpa) &&
      millis() - lastWindy >= WINDY_MS) {
    sendWindyV2(lastTempC, lastHum, lastPressHpa);
    lastWindy = millis();
  }
}
