void sdsSendCommand(const uint8_t *cmd, size_t len) {
  while (sdsSerial.available()) sdsSerial.read();
  for (size_t i = 0; i < len; i++) sdsSerial.write(cmd[i]);
  sdsSerial.flush();
}

void sdsSleep() {
  static const uint8_t cmd[] = {
    0xAA,0xB4,0x06,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xFF,0xFF,0x05,0xAB
  };
  sdsSendCommand(cmd, sizeof(cmd));
  DBG_PRINTLN("[SDS011] SLEEP");
}

void sdsWake() {
  static const uint8_t cmd[] = {
    0xAA,0xB4,0x06,0x01,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xFF,0xFF,0x06,0xAB
  };
  sdsSendCommand(cmd, sizeof(cmd));
  DBG_PRINTLN("[SDS011] WAKE");
}

bool readSDS011(float &outPm25, float &outPm10) {
  while (sdsSerial.available() >= 10) {
    if ((uint8_t)sdsSerial.read() != 0xAA) continue;
    if ((uint8_t)sdsSerial.read() != 0xC0) continue;

    uint8_t data[8];
    int got = sdsSerial.readBytes((char*)data, 8);
    if (got != 8) return false;

    uint8_t checksum = 0;
    for (int i = 0; i < 6; i++) checksum += data[i];
    if (checksum != data[6]) return false;
    if (data[7] != 0xAB) return false;

    uint16_t rawPm25 = (uint16_t)data[0] | ((uint16_t)data[1] << 8);
    uint16_t rawPm10 = (uint16_t)data[2] | ((uint16_t)data[3] << 8);

    outPm25 = rawPm25 / 10.0f;
    outPm10 = rawPm10 / 10.0f;
    return true;
  }
  return false;
}

void startMdnsIfNeeded() {
  if (WiFi.status() == WL_CONNECTED && !mdnsStarted) {
    if (MDNS.begin(MDNS_NAME)) {
      MDNS.addService("http", "tcp", 80);
      mdnsStarted = true;
    }
  }
}

void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  Serial.println();
  Serial.print("[WIFI] Connecting to: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.hostname(DEVICE_HOSTNAME);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500);
    Serial.print(".");
    yield();
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("[WIFI] Connected, IP: ");
    Serial.println(WiFi.localIP());
    initTime();
    startMdnsIfNeeded();
  } else {
    Serial.println("[WIFI] FAILED");
  }
}

bool connectAprs() {
  if (aprsClient.connected()) return true;

  DBG_PRINTF("[APRS] Connecting to %s:%u\n", APRS_HOST, APRS_PORT);
  if (!aprsClient.connect(APRS_HOST, APRS_PORT)) {
    DBG_PRINTLN("[APRS] TCP connect failed");
    aprsLoggedIn = false;
    return false;
  }

  String login = aprsLoginLine();
  aprsClient.print(login);
  aprsClient.print("\r\n");
  aprsLoggedIn = true;
  return true;
}

void sendAprsLine(const String &line) {
  markAprsAttempt(line);
  DBG_PRINT("[APRS] TX >> ");
  DBG_PRINTLN(line);

  if (aprsClient.connected()) {
    aprsClient.print(line);
    aprsClient.print("\r\n");
    markAprsResult(true, "ok");
  } else {
    markAprsResult(false, "socket disconnected");
  }
}

bool sendThingSpeakPrimary(float tempC, float hum, float pressHpa, float vpm25, float vpm10) {
  lastThingSpeakAttempt = millis();
  thingSpeakLastOk = false;
  thingSpeakLastHttpCode = 0;
  thingSpeakLastError = "pending";

  WiFiClient client;
  if (!client.connect(THINGSPEAK_HOST, 80)) {
    thingSpeakFailCount++;
    thingSpeakLastError = "connect failed";
    return false;
  }

  String url = "/update?api_key=" + String(THINGSPEAK_API_KEY_1) +
               "&field1=" + String(tempC,1) +
               "&field2=" + String(hum,1) +
               "&field3=" + String(pressHpa,1) +
               "&field4=" + String(vpm25,1) +
               "&field5=" + String(vpm10,1);

  client.print(String("GET ") + url + " HTTP/1.1\r\nHost: " + THINGSPEAK_HOST + "\r\nConnection: close\r\n\r\n");

  unsigned long timeout = millis();
  String firstLine = "";
  String body = "";
  bool gotHeaders = false;
  bool inBody = false;

  while ((client.connected() || client.available()) && millis() - timeout < 8000) {
    yield();
    while (client.available()) {
      yield();
      String line = client.readStringUntil('\n');
      timeout = millis();

      if (!gotHeaders) {
        String trimmed = line;
        trimmed.trim();
        if (trimmed.length() > 0 && firstLine.length() == 0) {
          firstLine = trimmed;
          if (trimmed.startsWith("HTTP/1.1 ") || trimmed.startsWith("HTTP/1.0 ")) {
            thingSpeakLastHttpCode = trimmed.substring(9, 12).toInt();
          }
        }
        if (line == "\r" || trimmed.length() == 0) {
          gotHeaders = true;
          inBody = true;
        }
      } else if (inBody) {
        body += line;
      }
    }
  }

  client.stop();
  body.trim();

  if (thingSpeakLastHttpCode == 200 && body.length() > 0 && body != "0") {
    thingSpeakLastOk = true;
    thingSpeakLastError = "entry " + body;
    lastThingSpeakSuccess = millis();
    return true;
  }

  thingSpeakFailCount++;
  if (thingSpeakLastHttpCode == 200 && body == "0") thingSpeakLastError = "entry 0";
  else if (body.length() > 0) thingSpeakLastError = body;
  else if (firstLine.length() > 0) thingSpeakLastError = firstLine;
  else thingSpeakLastError = "timeout/no response";

  return false;
}

bool sendWindyV2(float tempC, float hum, float pressHpa) {
  lastWindyAttempt = millis();
  windyLastOk = false;
  windyLastHttpCode = 0;
  windyLastError = "pending";

  if (windyClient.connected()) windyClient.stop();
  windyClient.setInsecure();
  windyClient.setBufferSizes(512, 512);

  if (!windyClient.connect(WINDY_HOST, 443)) {
    windyLastError = "connect failed";
    windyFailCount++;
    return false;
  }

  float tempF = tempC * 9.0f / 5.0f + 32.0f;
  float baroInHg = pressHpa * 0.0295299831f;

  String url = "/api/v2/observation/update"
               "?stationtype=ESP8266WX_3.2"
               "&ID=" + String(WINDY_STATION_ID) +
               "&PASSWORD=" + String(WINDY_STATION_PASSWORD) +
               "&dateutc=now"
               "&tempf=" + String(tempF, 1) +
               "&humidity=" + String((int)round(hum)) +
               "&baromin=" + String(baroInHg, 3) +
               "&action=updateraw";

  DBG_PRINT("[Windy] URL: ");
  DBG_PRINTLN(url);

  windyClient.print(String("GET ") + url + " HTTP/1.1\r\nHost: " + WINDY_HOST + "\r\nConnection: close\r\n\r\n");

  unsigned long timeout = millis();
  String firstLine = "";
  bool gotHeaders = false;

  while ((windyClient.connected() || windyClient.available()) && millis() - timeout < 7000) {
    yield();
    while (windyClient.available()) {
      yield();
      String line = windyClient.readStringUntil('\n');
      line.trim();
      timeout = millis();

      if (!gotHeaders && line.length() > 0) {
        firstLine = line;
        gotHeaders = true;
        if (line.startsWith("HTTP/1.1 ") || line.startsWith("HTTP/1.0 ")) {
          windyLastHttpCode = line.substring(9, 12).toInt();
        }
      }
    }
  }

  windyClient.stop();

  if (windyLastHttpCode == 200) {
    windyLastOk = true;
    windyLastError = "ok";
    lastWindySuccess = millis();
    return true;
  }

  windyFailCount++;
  windyLastError = firstLine.length() ? firstLine : "timeout/no response";
  return false;
}

String getSystemJson() {
